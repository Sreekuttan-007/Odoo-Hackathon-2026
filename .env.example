APP_ENV=development
SECRET_KEY=replace-this-with-a-long-random-secret
# Add your deployed frontend's origin here too once you have one, e.g.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Option 1 (default): local Docker PostgreSQL — see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://peoplepay:peoplepay_dev_password@localhost:5433/peoplepay

# Option 2: Neon (cloud PostgreSQL) — for demo/deployment. Get this from
# your Neon project's connection details page, then paste it here (never
# in a chat message or committed file). Keep the `+psycopg` driver and
# `sslmode=require` exactly as shown. See docs/NEON_DEPLOYMENT.md.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# Optional — PayTrace AI Narrator (Phase 7B) plain-language explanations.
# Leave unset to run without it: deterministic PayTrace works fully either way.
# ANTHROPIC_API_KEY=
